{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vector-atc",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "STATE_READ_LIMITER",
      "namespace_id": "2026091701",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "namespace_id": "2026091702",
      "simple": {
        "limit": 120,
        "period": 60
      },
      "name": "PRESENCE_LIMITER"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AIRPORT",
        "class_name": "AirportSimulation"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AirportSimulation"
      ]
    }
  ],
  "triggers": {
    "crons": []
  },
  "vars": {
    "TYPESAFE_MODEL": "jev-1.13.0",
    "AI_ENABLED": "false",
    "AI_INTERVAL_SECONDS": "60",
    "AI_DAILY_TOKEN_LIMIT": "3800000",
    "AI_HOURLY_REQUEST_LIMIT": "720",
    "SIM_SPEED": "1"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
