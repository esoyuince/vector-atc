{
  "name": "vector-typesafe-atc-demo",
  "private": true,
  "version": "0.6.5",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev --ip 127.0.0.1 --port 5173",
    "build": "vite build",
    "test": "node --test test/*.test.mjs",
    "deploy": "npm run build && wrangler deploy",
    "check:worker": "wrangler deploy --dry-run",
    "prebuild": "node scripts/write-provenance.mjs",
    "test:offline": "node --import ./scripts/offline-guard.mjs --test test/*.test.mjs",
    "verify:provenance": "node scripts/verify-provenance.mjs",
    "analyze:research": "node scripts/analyze-research.mjs",
    "soak:offline": "node --expose-gc --import ./scripts/offline-guard.mjs scripts/offline-soak.mjs",
    "check:worker:offline": "node --import ./scripts/offline-guard.mjs node_modules/wrangler/bin/wrangler.js deploy --dry-run --config wrangler.example.jsonc",
    "test:coverage:offline": "node --import ./scripts/offline-guard.mjs --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=90 --test test/*.test.mjs",
    "sweep:offline": "node --import ./scripts/offline-guard.mjs scripts/offline-sweep.mjs",
    "preflight:study": "node --import ./scripts/offline-guard.mjs scripts/study-preflight.mjs",
    "attach:rule-review": "node --import ./scripts/offline-guard.mjs scripts/attach-rule-review.mjs",
    "make:study-plan": "node --import ./scripts/offline-guard.mjs scripts/make-study-plan.mjs",
    "freeze:study-batch": "node --import ./scripts/offline-guard.mjs scripts/freeze-study-batch.mjs",
    "preflight:study-batch": "node --import ./scripts/offline-guard.mjs scripts/study-batch-preflight.mjs",
    "aggregate:study": "node --import ./scripts/offline-guard.mjs scripts/aggregate-study.mjs",
    "make:rule-review-packet": "node --import ./scripts/offline-guard.mjs scripts/make-rule-review-packet.mjs",
    "verify:aviation-sources": "node scripts/verify-aviation-sources.mjs",
    "arm:study": "node scripts/arm-study.mjs",
    "verify:aviation-values": "python scripts/verify-aviation-values.py"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "vite": "^7.0.0",
    "wrangler": "^4.133.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/esoyuince/vector-atc.git"
  }
}
